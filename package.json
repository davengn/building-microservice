{
  "name": "building-microservices-study-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static-first interactive study site for original microservices learning notes.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "a11y": "playwright test tests/accessibility",
    "content:check-sources": "tsx scripts/content/check-sources.ts",
    "content:generate": "tsx scripts/content/generate-drafts.ts",
    "content:validate": "tsx scripts/content/validate-content.ts",
    "graph:validate": "tsx scripts/content/validate-graph.ts",
    "search:build": "tsx scripts/content/build-pagefind.ts",
    "links:check": "tsx scripts/validate/check-links.ts",
    "audit:source": "tsx scripts/validate/audit-source.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@xyflow/react": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.4",
    "pagefind": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
